---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from './ArticleCard.astro';
import { getPublishedPosts } from '../utils/content';
interface Props { section: string; title: string; description: string; }
const { section, title, description } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => post.data.section === section);
---
<BaseLayout title={`${title} · VIVA Open Synth Brasil`} description={description}><div class="container page-head"><span class="eyebrow">Biblioteca VIVA</span><h1>{title}</h1><p>{description}</p></div><section class="section"><div class="container"><div class="dashboard-article-grid section-index-grid">{posts.map((post) => <ArticleCard title={post.data.title} description={post.data.description} slug={post.slug} category={post.data.category} pubDate={post.data.pubDate} image={post.data.heroImage} imageAlt={post.data.heroAlt} href={`/${post.data.section}/${post.slug}/`} />)}</div>{posts.length === 0 && <div class="empty-state"><strong>Nenhuma publicação nesta seção ainda.</strong><p>Estamos preparando novos materiais para a biblioteca VIVA.</p></div>}</div></section></BaseLayout>
