---
interface NavItem { href: string; label: string; key: string; icon: string; }
interface Props { items: NavItem[]; currentPath: string; }
const { items, currentPath } = Astro.props;
---
<aside class="site-dock" aria-label="Navegação lateral">
  <div class="dock-brand">
    <a class="brand" data-astro-prefetch="hover" href="/" aria-label="VIVA Open Synth Brasil, página inicial">
      <span class="brand-mark">VIVA :::</span><span>Open Synth Brasil</span>
    </a>
    <p class="dock-caption">um projeto do Studio Pomar<br />síntese vocal aberta / br</p>
  </div>
  <span class="dock-label">Espaço de trabalho</span>
  <nav class="dock-nav" aria-label="Navegação principal">
    {items.map((item) => {
      const active = currentPath === item.key || (item.key !== '/' && currentPath.startsWith(item.key));
      return <a data-astro-prefetch="hover" class:list={{ active }} href={item.href} aria-current={active ? 'page' : undefined}><img class="nav-icon" src={item.icon} alt="" aria-hidden="true" />{item.label}</a>;
    })}
  </nav>
  <div class="dock-status">
    <span class="status-badge status-green"><i aria-hidden="true"></i>comunidade online</span>
    <p>VIVA / Studio Pomar<br />rede de conteúdo · 2026</p>
  </div>
</aside>
