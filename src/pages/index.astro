---
import BaseLayout from '../layouts/BaseLayout.astro';
import { technologies } from '../data/site';
import { getPublishedPosts, formatDate } from '../utils/content';
const posts = await getPublishedPosts();
const [featured, ...latest] = posts;
---
<BaseLayout title="VIVA ::: Open Synth Brasil — software livre e síntese de voz">
  <section class="hero"><div class="container"><span class="eyebrow">Voz · Inovação · Virtualidade · Arte</span><h1>O futuro da voz também pode ser aberto.</h1><p>Comunidade brasileira de síntese vocal e software livre: notícias, recursos e conversas sobre canto digital e as ferramentas que colocam a criação nas mãos de todo mundo.</p><p class="brand-note"><span aria-hidden="true">$</span> VIVA ::: Open Synth Brasil</p><a class="button" href="/artigos/">Explorar artigos <span aria-hidden="true">↗</span></a></div></section>
  {featured && <section class="section"><div class="container feature"><div class="feature-art" aria-label="Ilustração abstrata de ondas sonoras">∿</div><div><span class="eyebrow">Em destaque · {featured.data.category}</span><h2>{featured.data.title}</h2><p>{featured.data.description}</p><p class="meta">{formatDate(featured.data.pubDate)}</p><a class="button" href={`/artigos/${featured.slug}/`}>Ler matéria</a></div></div></section>}
  <section class="section"><div class="container"><div class="section-header"><h2>Mais recente</h2><a href="/artigos/">Ver todos os artigos →</a></div><div class="post-grid">{latest.slice(0,3).map((post) => <article class="post-card"><div class="card-art"><span class="eyebrow">{post.data.category}</span></div><div class="card-body"><span class="meta">{formatDate(post.data.pubDate)}</span><h3><a href={`/artigos/${post.slug}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="read-more" href={`/artigos/${post.slug}/`}>Continuar lendo →</a></div></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-header"><h2>O que estamos acompanhando</h2><a href="/projetos/">Conhecer projetos →</a></div><div class="tech-grid">{technologies.map((tech) => <a class="tech" href={`/projetos/${tech.slug}/`}><strong>{tech.name}</strong><small>{tech.kind}</small></a>)}</div></div></section>
</BaseLayout>
