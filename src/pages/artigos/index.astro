---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate } from '../../utils/content';
const posts = await getPublishedPosts();
---
<BaseLayout title="Artigos — VIVA Open Synth Brasil" description="Notícias, análises e guias sobre software livre e síntese de voz."><div class="container page-head"><span class="eyebrow">Arquivo editorial</span><h1>Artigos</h1><p>Novidades, explicações e caminhos para explorar ferramentas abertas de voz.</p></div><section class="section"><div class="container"><div class="post-grid">{posts.map((post) => <article class="post-card"><div class="card-art"><span class="eyebrow">{post.data.category}</span></div><div class="card-body"><span class="meta">{formatDate(post.data.pubDate)}</span><h3><a href={`/artigos/${post.slug}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><div>{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div><a class="read-more" href={`/artigos/${post.slug}/`}>Ler artigo →</a></div></article>)}</div></div></section></BaseLayout>
