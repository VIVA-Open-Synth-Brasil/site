---
import BaseLayout from '../../layouts/BaseLayout.astro';
const resources = [{ title:'Comece pelo OpenUtau', text:'Um ponto de partida para conhecer edição vocal, voicebanks e projetos de síntese cantada.', href:'https://github.com/stakira/OpenUtau', label:'Visitar repositório' }, { title:'Documentação e referências', text:'Uma coleção crescente de links, manuais e materiais para estudar voz digital com autonomia.', href:'/contato/', label:'Sugerir recurso' }, { title:'Glossário de síntese', text:'Termos essenciais para entender UTAU, DiffSinger, fonemas, modelos e renderização.', href:'/artigos/', label:'Ler artigos' }];
---
<BaseLayout title="Recursos — VIVA Open Synth Brasil" description="Recursos abertos para aprender e criar com síntese de voz."><div class="container page-head"><span class="eyebrow">Caixa de ferramentas</span><h1>Recursos</h1><p>Links, referências e materiais para transformar curiosidade em prática.</p></div><section class="section"><div class="container resource-grid">{resources.map((item) => <article class="resource"><span class="eyebrow">Recurso aberto</span><h3>{item.title}</h3><p>{item.text}</p><a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">{item.label} ↗</a></article>)}</div></section></BaseLayout>
