---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { technologies } from '../../data/site';
export function getStaticPaths(){ return technologies.map((tech) => ({ params:{ slug:tech.slug }, props:{ tech } })); }
const { tech } = Astro.props;
---
<BaseLayout title={`${tech.name} — Projetos — Voz Livre Brasil`} description={`Acompanhe notícias e recursos sobre ${tech.name} no Voz Livre Brasil.`}><article class="article"><header class="article-header"><span class="eyebrow">Projeto acompanhado</span><h1>{tech.name}</h1><p class="lead">{tech.kind}. Esta página será o ponto de entrada para artigos, atualizações e recursos relacionados.</p></header><div class="article-content"><h2>O que você encontrará aqui</h2><p>O Voz Livre Brasil acompanha iniciativas abertas que tornam a criação vocal mais acessível. Quando houver novas publicações sobre este projeto, elas aparecerão nesta página e no arquivo de artigos.</p><p><a href="/artigos/">Ver todos os artigos →</a></p></div></article></BaseLayout>
