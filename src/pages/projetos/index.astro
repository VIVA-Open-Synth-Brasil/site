---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { technologies } from '../../data/site';
---
<BaseLayout title="Projetos · VIVA Open Synth Brasil" description="Projetos e tecnologias acompanhados pelo VIVA Open Synth Brasil."><div class="container page-head"><span class="eyebrow">Mapa do ecossistema</span><h1>Projetos</h1><p>Ferramentas e iniciativas que estão expandindo o que podemos fazer com voz digital.</p></div><section class="section"><div class="container project-grid">{technologies.map((tech) => <article class="resource"><span class="eyebrow">Em acompanhamento</span><h3>{tech.name}</h3><p>{tech.kind}. Em breve, esta página reunirá notícias, atualizações e referências específicas do projeto.</p><a href={`/projetos/${tech.slug}/`}>Ver página do projeto →</a></article>)}</div></section></BaseLayout>
