    <button class="theme-toggle" type="button" aria-label="Ativar modo escuro" aria-pressed="false" title="Ativar modo escuro">◐</button>
    <button class="back-to-top" type="button" aria-label="Voltar ao topo" title="Voltar ao topo">↑</button>
    <script>
      const setupVivaInteractions = () => {
        const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
        if (themeToggle && !themeToggle.dataset.bound) {
          const updateThemeButton = () => {
            const dark = document.documentElement.dataset.theme === 'dark';
            themeToggle.textContent = dark ? '☀' : '◐';
            themeToggle.setAttribute('aria-pressed', String(dark));
            themeToggle.setAttribute('aria-label', dark ? 'Ativar modo intermediário' : 'Ativar modo escuro');
            themeToggle.title = dark ? 'Ativar modo intermediário' : 'Ativar modo escuro';
          };
          themeToggle.addEventListener('click', () => {
            const dark = document.documentElement.dataset.theme === 'dark';
            document.documentElement.dataset.theme = dark ? 'light' : 'dark';
            localStorage.setItem('viva-theme', dark ? 'light' : 'dark');
            updateThemeButton();
          });
          themeToggle.dataset.bound = 'true';
          updateThemeButton();
        }
        const backToTop = document.querySelector<HTMLButtonElement>('.back-to-top');
        if (backToTop && !backToTop.dataset.bound) {
          const updateBackToTop = () => backToTop.classList.toggle('is-visible', window.scrollY > 420);
          window.addEventListener('scroll', updateBackToTop, { passive: true });
          backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
          backToTop.dataset.bound = 'true';
          updateBackToTop();
        }
        document.querySelector<HTMLElement>('#conteudo')?.focus({ preventScroll: true });
      };
      const setupTopbarSearch = () => {
        const form = document.querySelector<HTMLFormElement>('.topbar-search-form');
        const input = form?.querySelector<HTMLInputElement>('#topbar-search');
        const results = form?.querySelector<HTMLElement>('[data-topbar-results]');
        const items = form ? Array.from(form.querySelectorAll<HTMLElement>('[data-search-item]')) : [];
        const empty = form?.querySelector<HTMLElement>('[data-search-empty]');
        if (!form || !input || !results || form.dataset.bound === 'true') return;
        const render = () => {
          const query = input.value.toLowerCase().trim();
          if (!query) { results.hidden = true; return; }
          const visible = items.filter((item) => item.dataset.searchText?.includes(query));
          items.forEach((item) => { item.hidden = !visible.includes(item); });
          if (empty) empty.hidden = visible.length > 0;
          results.hidden = false;
        };
        input.addEventListener('input', render);
        input.addEventListener('focus', render);
        input.addEventListener('keydown', (event) => { if (event.key === 'Escape') { results.hidden = true; input.blur(); } });
        form.addEventListener('submit', (event) => { event.preventDefault(); render(); });
        document.addEventListener('click', (event) => { if (!form.contains(event.target as Node)) results.hidden = true; });
        form.dataset.bound = 'true';
      };
      const setupToolTables = () => {
        document.querySelectorAll<HTMLTableElement>('.article-content table').forEach((table) => {
          if (table.dataset.enhanced === 'true') return;
          const headers = Array.from(table.querySelectorAll('thead th')).map((cell) => cell.textContent?.trim().toLowerCase());
          if (!headers.includes('categoria') || !headers.includes('software') || !headers.includes('sistemas')) return;
          const categoryIndex = headers.indexOf('categoria');
          const softwareIndex = headers.indexOf('software');
          const systemsIndex = headers.indexOf('sistemas');
          const rows = Array.from(table.querySelectorAll<HTMLTableRowElement>('tbody tr'));
          const values = (index: number) => [...new Set(rows.map((row) => row.cells[index]?.textContent?.trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
          const shell = document.createElement('div');
          shell.className = 'tool-table-shell';
          table.parentNode?.insertBefore(shell, table);
          shell.appendChild(table);
          const controls = document.createElement('div');
          controls.className = 'tool-table-controls';
          controls.innerHTML = `<label>Filtrar <input type="search" data-tool-filter placeholder="Nome ou uso" /></label><label>Categoria <select data-tool-category><option value="">Todas</option></select></label><label>Sistema <select data-tool-system><option value="">Todos</option></select></label><label>Ordenar <select data-tool-sort><option value="software">Software</option><option value="category">Categoria</option></select></label><span class="tool-table-count" aria-live="polite"></span>`;
          shell.insertBefore(controls, table);
          const filter = controls.querySelector<HTMLInputElement>('[data-tool-filter]');
          const category = controls.querySelector<HTMLSelectElement>('[data-tool-category]');
          const system = controls.querySelector<HTMLSelectElement>('[data-tool-system]');
          const sort = controls.querySelector<HTMLSelectElement>('[data-tool-sort]');
          const count = controls.querySelector<HTMLSpanElement>('.tool-table-count');
          values(categoryIndex).forEach((value) => category?.insertAdjacentHTML('beforeend', `<option value="${value}">${value}</option>`));
          values(systemsIndex).forEach((value) => system?.insertAdjacentHTML('beforeend', `<option value="${value}">${value}</option>`));
          const render = () => {
            const query = filter?.value.toLowerCase().trim() || '';
            const selectedCategory = category?.value || '';
            const selectedSystem = system?.value || '';
            const visible = rows.filter((row) => {
              const text = row.textContent?.toLowerCase() || '';
              return (!query || text.includes(query)) && (!selectedCategory || row.cells[categoryIndex]?.textContent?.trim() === selectedCategory) && (!selectedSystem || row.cells[systemsIndex]?.textContent?.trim() === selectedSystem);
            });
            const sorted = [...visible].sort((a, b) => (sort?.value === 'category' ? a.cells[categoryIndex]?.textContent || '' : a.cells[softwareIndex]?.textContent || '').localeCompare(sort?.value === 'category' ? b.cells[categoryIndex]?.textContent || '' : b.cells[softwareIndex]?.textContent || '', 'pt-BR'));
            rows.forEach((row) => { row.hidden = !visible.includes(row); });
            sorted.forEach((row) => table.tBodies[0]?.appendChild(row));
            if (count) count.textContent = `${visible.length} de ${rows.length} ferramentas`;
          };
          [filter, category, system, sort].forEach((control) => control?.addEventListener('input', render));
          [category, system, sort].forEach((control) => control?.addEventListener('change', render));
          table.dataset.enhanced = 'true';
          render();
        });
      };
      document.addEventListener('astro:before-preparation', () => document.documentElement.classList.add('is-navigating'));
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.remove('is-navigating'));
      document.addEventListener('astro:page-load', () => { setupVivaInteractions(); setupTopbarSearch(); setupToolTables(); });
      setupVivaInteractions();
      setupTopbarSearch();
      setupToolTables();
    </script>
  </body>
</html>
