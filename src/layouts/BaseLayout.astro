---
import { SITE } from '../data/site';
import SidebarNav from '../components/SidebarNav.astro';
import Topbar from '../components/Topbar.astro';
import ContextPanel from '../components/ContextPanel.astro';
import { ClientRouter } from 'astro:transitions';
import { getPublishedPosts } from '../utils/content';
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; }
const { title = SITE.name, description = SITE.description, image = '/og-default.svg', type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const currentPath = Astro.url.pathname;
const searchPosts = (await getPublishedPosts()).map(({ slug, data }) => ({ slug, title: data.title, description: data.description, category: data.category, tags: data.tags }));
const navItems = [
  { href: '/', label: 'Início', key: '/', icon: '/icons/flaticon/home.svg' },
  { href: '/artigos/', label: 'Artigos', key: '/artigos/', icon: '/icons/flaticon/book.svg' },
  { href: '/recursos/', label: 'Recursos', key: '/recursos/', icon: '/icons/flaticon/folder.svg' },
  { href: '/projetos/', label: 'Projetos', key: '/projetos/', icon: '/icons/flaticon/folder.svg' },
  { href: '/enciclopedia/', label: 'Enciclopédia', key: '/enciclopedia/', icon: '/icons/flaticon/book.svg' },
  { href: '/guias/', label: 'Guias', key: '/guias/', icon: '/icons/flaticon/book.svg' },
  { href: '/ferramentas/', label: 'Ferramentas', key: '/ferramentas/', icon: '/icons/flaticon/folder.svg' },
  { href: '/comunidade/', label: 'Comunidade', key: '/comunidade/', icon: '/icons/flaticon/audio-waves.svg' },
  { href: '/sobre/', label: 'Sobre', key: '/sobre/', icon: '/icons/flaticon/audio-waves.svg' }
];
const isArticle = currentPath.startsWith('/artigos/') || currentPath.startsWith('/guias/') || currentPath.startsWith('/enciclopedia/') || currentPath.startsWith('/ferramentas/') || currentPath.startsWith('/comunidade/') || currentPath.startsWith('/recursos/megathread');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <title>{title}</title>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, SITE.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, SITE.url).toString()} />
    <script is:inline>document.documentElement.dataset.theme = localStorage.getItem('viva-theme') === 'dark' ? 'dark' : 'light';</script>
    <ClientRouter />
    <slot name="head" />
    <style is:global>
      :root { --pink: #e84f9a; --blue: #3ba9d6; --graphite: #173a32; --warm: #bdd6ca; --paper: #bfd2c9; --card: #edf4ef; --ink: #142b27; --muted: #49665d; --green: #08725c; --line: #8eafa1; }
      html[data-theme="dark"] { --pink: #ff75b5; --blue: #69cdf2; --graphite: #102b25; --warm: #203c34; --paper: #172a26; --card: #243e36; --ink: #effbf4; --muted: #aac5b8; --green: #70e0b9; --line: #41675a; }
      .brand { min-width: 0; }
      .brand-mark { flex: 0 0 auto; width: auto; min-width: 74px; padding: 0 8px; font-size: .55rem; letter-spacing: -.08em; }
      .brand > span:last-child { min-width: 0; letter-spacing: -.04em; overflow-wrap: anywhere; }
      .studio-signature { color: var(--muted); font: 500 .62rem 'DM Mono', monospace; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }
      body { position: relative; overflow-x: hidden; }
      .particle-field { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; opacity: .65; }
      .particle { position: absolute; display: block; width: 5px; height: 5px; border-radius: 50%; background: var(--green); box-shadow: 0 0 16px #75d9ad88; animation: particle-drift 4s ease-in-out infinite alternate; will-change: transform, opacity; }
      .particle:nth-child(1) { top: 16%; left: 8%; animation-delay: -1s; }
      .particle:nth-child(2) { top: 28%; left: 23%; width: 3px; height: 3px; background: var(--orange); animation-delay: -4s; }
      .particle:nth-child(3) { top: 12%; right: 18%; animation-delay: -2s; }
      .particle:nth-child(4) { top: 43%; right: 8%; width: 4px; height: 4px; background: var(--orange); animation-delay: -6s; }
      .particle:nth-child(5) { top: 62%; left: 12%; width: 3px; height: 3px; animation-delay: -3s; }
      .particle:nth-child(6) { top: 74%; left: 31%; animation-delay: -7s; }
      .particle:nth-child(7) { top: 82%; right: 24%; width: 3px; height: 3px; background: var(--orange); animation-delay: -5s; }
      .particle:nth-child(8) { top: 56%; right: 42%; width: 4px; height: 4px; animation-delay: -2s; }
      .particle:nth-child(9) { top: 34%; right: 32%; width: 2px; height: 2px; background: var(--orange); animation-delay: -4s; }
      .particle:nth-child(10) { top: 91%; left: 6%; width: 3px; height: 3px; animation-delay: -6s; }
      @keyframes particle-drift { 0% { transform: translate3d(0, 0, 0) scale(.7); opacity: .35; } 50% { opacity: 1; } 100% { transform: translate3d(32px, -48px, 0) scale(1.35); opacity: .8; } }
      .site-header, main, .site-footer { position: relative; z-index: 1; }
      @media (prefers-reduced-motion: reduce) { .particle { animation: none; } }
      .back-to-top { position: fixed; right: 24px; bottom: 24px; z-index: 3; display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--green); border-radius: 50%; background: var(--green); color: #fff; font: 1.3rem/1 'DM Mono', monospace; cursor: pointer; opacity: 0; visibility: hidden; transform: translateY(12px); transition: opacity .2s ease, visibility .2s ease, transform .2s ease, background .2s ease; }
      .back-to-top:hover { background: #094b3d; }
      .back-to-top:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }
      .back-to-top.is-visible { opacity: 1; visibility: visible; transform: translateY(0); }
      @media (max-width: 760px) { .back-to-top { right: 14px; bottom: 14px; } }
      .theme-toggle { position: fixed; right: 24px; bottom: 78px; z-index: 3; display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; background: var(--card); color: var(--ink); box-shadow: 0 8px 18px #29423b22; font: 1.2rem/1 'DM Mono', monospace; cursor: pointer; transition: transform .2s ease, background-color .2s ease, color .2s ease; }
      .theme-toggle:hover { transform: translateY(-2px); background: var(--green); color: #fff; }
      .theme-toggle:focus-visible { outline: 3px solid var(--pink); outline-offset: 3px; }
      @media (max-width: 760px) { .theme-toggle { right: 14px; bottom: 68px; } }
      .hero .container { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(300px, .88fr); gap: 64px; align-items: center; }
      .hero-copy h1 { max-width: 720px; font-size: clamp(2.8rem, 5.4vw, 5.25rem); }
      .hero-panel { overflow: hidden; border: 1px solid #244c40; border-radius: 16px; background: var(--graphite); color: #d7f7e2; box-shadow: 16px 18px 0 #c9f0d855; }
      .terminal-bar { display: flex; align-items: center; gap: 7px; padding: 13px 16px; border-bottom: 1px solid #2d5147; color: #9cc3ad; font: .68rem 'DM Mono', monospace; }
      .terminal-bar > span { width: 8px; height: 8px; border-radius: 50%; background: #f0784b; }
      .terminal-bar > span:nth-child(2) { background: var(--pink); }
      .terminal-bar > span:nth-child(3) { background: var(--blue); }
      .terminal-bar small { margin-left: 8px; }
      .terminal-body { padding: 28px 24px 26px; font: .76rem/1.5 'DM Mono', monospace; }
      .terminal-body p { margin: 0 0 28px; color: #b9d9c5; font: inherit; }
      .terminal-prompt { color: #7ff0aa; }
      .waveform { display: flex; align-items: center; justify-content: center; gap: 5px; height: 110px; border-top: 1px solid #2d5147; border-bottom: 1px solid #2d5147; }
      .waveform i { width: 5px; height: 28%; border-radius: 5px; background: #8de5aa; }
      .waveform i:nth-child(2n) { height: 62%; background: #c9f0d8; }
      .waveform i:nth-child(3n) { height: 88%; background: #f0784b; }
      .waveform i:nth-child(5n) { height: 42%; }
      .terminal-list { display: grid; grid-template-columns: 1fr auto; gap: 9px 16px; padding-top: 24px; color: #e4faea; }
      .terminal-list b { color: #7ff0aa; font-weight: 500; }
      .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 18px; margin-top: 24px; }
      .hero-status { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font: .68rem 'DM Mono', monospace; letter-spacing: .04em; text-transform: uppercase; }
      .hero-status i { width: 6px; height: 6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 10px var(--green); }
      .featured-dashboard { display: grid; grid-template-columns: minmax(180px, .8fr) 1.2fr; gap: 26px; align-items: center; }
      .featured-dashboard h3 { margin: 8px 0 12px; font-size: clamp(1.6rem, 3vw, 2.55rem); }
      .featured-dashboard p { max-width: 560px; color: var(--muted); }
      .feature-art { display: grid; min-height: 230px; place-items: center; border: 1px solid #244c40; border-radius: 12px; background: var(--graphite); color: var(--mint); font: 8rem/1 'DM Mono', monospace; box-shadow: 12px 12px 0 #ff5ca826; }
      .breadcrumb { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; color: var(--muted); font: .68rem 'DM Mono', monospace; }
      .breadcrumb a { color: var(--green); }
      .breadcrumb span:last-child { max-width: min(60vw, 520px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      @media (max-width: 760px) { .hero .container { grid-template-columns: 1fr; gap: 42px; } .hero-panel { max-width: 540px; } }
      .tech { padding: 0; overflow: hidden; }
      .tech-image { position: relative; height: 142px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #fff; }
      .tech-image img { display: block; width: 100%; height: 100%; object-fit: cover; background: #fff; }
      .tech-image img.contain { object-fit: contain; padding: 16px; background: #fff; }
      .tech-image span { position: absolute; right: 8px; bottom: 8px; padding: 4px 7px; color: #e9fff5; background: rgba(13, 19, 18, .86); font: .65rem/1.2 var(--mono); }
      .tech-image a { color: var(--mint); }
      .tech-content { display: grid; gap: 7px; padding: 16px 18px 18px; }
      .tech-label { color: var(--pink); font: 500 .62rem 'DM Mono', monospace; letter-spacing: .1em; text-transform: uppercase; }
      .tech-name { color: var(--ink); text-decoration: none; }
      .tech-name strong { display: block; }
      .tech-content small { color: var(--muted); }
      .tech-source { width: fit-content; color: var(--green); font: .72rem var(--mono); }
      .article-content img { background: #fff; }
      .article-content a.button, .article-content a.button:hover { color: #fff; text-decoration: none; }
      .article-figure { margin: 0 0 42px; }
      .article-figure-frame { overflow: hidden; border: 1px solid var(--line); border-radius: 14px; background: #fff; box-shadow: 0 12px 28px #29423b18; }
      .article-figure img { display: block; width: 100%; height: auto; background: #fff; }
      .article-figure figcaption { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 11px; color: var(--muted); font: .72rem/1.55 'DM Mono', monospace; }
      .article-figure figcaption span { display: inline; }
      .article-figure figcaption a { color: var(--green); text-decoration: underline; }
      .article-figure .figure-credit, .article-figure .figure-license { color: var(--muted); }
      @media (prefers-reduced-motion: reduce) { .article-figure-frame { box-shadow: none; } }
      .article-content h2 { padding-left: 14px; border-left: 3px solid var(--pink); }
      .article-content h3 { color: var(--green); }
      .credit-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 18px; }
      .credit-card { padding: 18px; border: 1px solid var(--line); border-top: 3px solid var(--pink); border-radius: 10px; background: #fff; }
      .tech, .resource, .credit-card, .search-box input { background: var(--card); }
      .site-footer { background: #bdcec5; }
      .credit-card strong { display: block; margin-bottom: 5px; color: var(--green); font: 500 .72rem 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
      .credit-card p { margin: 0; color: var(--muted); font-size: .92rem; }
      .character-credits { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 24px 0 42px; }
      .character-credits figure { min-width: 0; margin: 0; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); }
      .character-credits img { display: block; width: 100%; height: 250px; object-fit: contain; }
      .character-credits figcaption { margin-top: 12px; color: var(--muted); font: .7rem/1.5 'DM Mono', monospace; }
      .character-credits figcaption a { color: var(--green); text-decoration: underline; }
      .icon-credits { padding-left: 20px; color: var(--muted); font-size: .9rem; }
      .icon-credits li { margin: 8px 0; }
      @media (max-width: 760px) { .studio-signature { display: none; } .credit-grid, .character-credits { grid-template-columns: 1fr; } .character-credits img { height: 220px; } }
      .site-shell { position: relative; z-index: 1; display: flex; min-height: 100vh; }
      .site-dock { position: sticky; top: 0; display: flex; flex: 0 0 240px; flex-direction: column; width: 240px; min-height: 100vh; padding: 22px 0 18px; border-right: 1px solid var(--line); background: #d5e0d9e8; backdrop-filter: blur(14px); }
      .dock-brand { padding: 0 22px 26px; }
      .dock-brand .brand { align-items: flex-start; white-space: normal; line-height: 1.05; }
      .dock-brand .brand > span:last-child { max-width: 128px; }
      .dock-caption { margin-top: 12px; color: var(--muted); font: .62rem/1.5 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; }
      .dock-label { padding: 0 22px 9px; color: var(--muted); font: 500 .62rem 'DM Mono', monospace; letter-spacing: .1em; text-transform: uppercase; }
      .dock-nav { display: flex; flex-direction: column; gap: 4px; }
      .dock-nav a { display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 0 22px; border-left: 4px solid transparent; color: var(--muted); font-size: .88rem; }
      .dock-nav a::before { content: ''; width: 3px; height: 3px; margin-right: 2px; border-radius: 50%; background: var(--pink); opacity: .55; }
      .nav-icon { width: 20px; height: 20px; object-fit: contain; opacity: .68; filter: saturate(.7); }
      .dock-nav a:hover, .dock-nav a.active { border-left-color: var(--pink); background: #ff5ca80d; color: var(--ink); text-decoration: none; }
      .dock-nav a.active { font-weight: 700; }
      .dock-nav a.active .nav-icon, .dock-nav a:hover .nav-icon { opacity: 1; filter: saturate(1); }
      .dock-status { margin: auto 22px 0; padding-top: 16px; border-top: 1px solid var(--line); }
      .dock-status p { margin: 10px 0 0; color: var(--muted); font: .68rem/1.5 'DM Mono', monospace; }
      .site-stage { min-width: 0; flex: 1; }
      .site-header { position: sticky; top: 0; z-index: 10; border-bottom: 1px solid var(--line); background: var(--paper); box-shadow: 0 6px 18px #29423b12; }
      .topbar { display: flex; min-height: 64px; align-items: center; gap: 22px; }
      .topbar-mobile-brand { display: none; }
      .topbar-path { color: var(--muted); font: .7rem 'DM Mono', monospace; letter-spacing: .04em; }
      .topbar-status { display: flex; align-items: center; gap: 8px; margin-left: auto; color: var(--muted); font: .68rem 'DM Mono', monospace; }
      .topbar-status i, .status-badge i { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: currentColor; box-shadow: 0 0 10px currentColor; }
      .topbar-status i { color: var(--green); }
      .topbar-search { color: var(--green); font-size: 1.6rem; line-height: 1; }
      .site-stage > main { min-height: calc(100vh - 64px); }
      .site-stage .site-footer { margin-top: 0; }
      html[data-theme="dark"] .site-dock, html[data-theme="dark"] .context-panel { background: #203832ee; }
      html[data-theme="dark"] .site-footer { background: #1b302a; }
      html[data-theme="dark"] .dashboard-panel, html[data-theme="dark"] .article-meta-panel { background: #263f38e8; }
      html[data-theme="dark"] .metric-card { background: #29443c; }
      html[data-theme="dark"] .metric-active { background: #315b4c; border-color: #639f87; }
      html[data-theme="dark"] .context-links a:hover, html[data-theme="dark"] .dock-nav a:hover, html[data-theme="dark"] .dock-nav a.active { background: #f18ab91c; }
      html[data-theme="dark"] .article-content code { background: #304b42; }
      .status-badge { display: inline-flex; align-items: center; gap: 6px; width: fit-content; padding: 4px 8px; border-radius: 999px; font: 500 .61rem 'DM Mono', monospace; letter-spacing: .04em; text-transform: uppercase; }
      .status-green { color: var(--green); background: #c9f0d899; }
      .status-pink { color: #b82a6a; background: #ff5ca826; }
      .status-blue { color: #1678a8; background: #5cc8ff2e; }
      .status-orange { color: #a94827; background: #f0784b2e; }
      .dashboard-panel { padding: 24px; border: 1px solid var(--line); border-radius: 14px; background: #dce8e2e8; box-shadow: 0 12px 28px #29423b18; }
      .panel-header { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
      .panel-header h2 { margin: 5px 0 0; font-size: 1.8rem; }
      .panel-link, .card-action { color: var(--green); font-size: .82rem; font-weight: 700; }
      .dashboard-article-grid, .dashboard-project-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
      .section-index-grid { align-items: stretch; }
      .empty-state { margin-top: 8px; padding: 28px; border: 1px dashed var(--line); border-radius: 12px; background: var(--card); color: var(--muted); }
      .empty-state strong { display: block; margin-bottom: 5px; color: var(--ink); }
      .empty-state p { margin: 0; font-size: .88rem; }
      .dashboard-article-card { display: flex; min-height: 250px; min-width: 0; flex-direction: column; padding: 20px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
      .dashboard-card-image { display: block; overflow: hidden; height: 132px; margin: -20px -20px 18px; border-bottom: 1px solid var(--line); background: #fff; }
      .dashboard-card-image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .25s ease; }
      .dashboard-card-image:hover img { transform: scale(1.025); }
      .dashboard-card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      .dashboard-date { margin: 20px 0 8px; color: var(--muted); font: .68rem 'DM Mono', monospace; }
      .dashboard-article-card h3, .dashboard-project-card h3 { margin-bottom: 10px; font-size: 1.25rem; }
      .dashboard-article-card h3 a, .dashboard-project-card h3 a { color: var(--ink); }
      .dashboard-article-card > p:not(.dashboard-date), .project-card-body > p { margin: 0 0 18px; color: var(--muted); font-size: .86rem; }
      .dashboard-article-card .card-action, .dashboard-project-card .card-action { margin-top: auto; }
      .dashboard-project-card { min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
      .project-image { position: relative; height: 150px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #fff; }
      .project-image img { display: block; width: 100%; height: 100%; object-fit: cover; background: #fff; }
      .project-image img.contain { object-fit: contain; padding: 16px; }
      .project-image span { position: absolute; right: 8px; bottom: 8px; padding: 4px 7px; color: #e9fff5; background: #0d131edd; font: .62rem/1.2 'DM Mono', monospace; }
      .project-image a { color: var(--mint); }
      .project-card-body { display: flex; min-height: 155px; flex-direction: column; padding: 16px 18px 18px; }
      .article-meta-panel { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 0 0 34px; padding: 14px; border: 1px solid var(--line); border-radius: 10px; background: #edf2eec9; }
      .post-card-image { display: block; overflow: hidden; height: 170px; background: #fff; }
      .post-card-image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .25s ease; }
      .post-card-image:hover img { transform: scale(1.025); }
      @media (prefers-reduced-motion: reduce) { .dashboard-card-image img, .post-card-image img { transition: none; } .dashboard-card-image:hover img, .post-card-image:hover img { transform: none; } }
      .article-meta-row { display: flex; flex-direction: column; gap: 4px; padding-right: 10px; border-right: 1px solid var(--line); }
      .article-meta-row span { color: var(--muted); font: .6rem 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
      .article-meta-row strong { color: var(--ink); font-size: .78rem; }
      .article-tags { grid-column: 1 / -1; padding-top: 5px; }
      .site-stage .article { padding-top: 54px; }
      @media (max-width: 1024px) { .site-dock { flex-basis: 190px; width: 190px; } .dock-brand { padding-left: 16px; } .dock-label, .dock-nav a { padding-left: 16px; padding-right: 16px; } .dock-status { margin-left: 16px; margin-right: 16px; } .dashboard-article-grid, .dashboard-project-grid { grid-template-columns: repeat(2, 1fr); } }
